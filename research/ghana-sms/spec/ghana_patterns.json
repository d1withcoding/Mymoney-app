{
  "spec_version": "1.1.0",
  "title": "Ghana mobile-money SMS extraction specification (MTN MoMo / Telecel Cash / AirtelTigo Money)",
  "status": "DRAFT - regexes are grounded in published message samples and MUST be re-fitted against the author's collected corpus (see corpus/CORPUS_SCHEMA.md).",
  "currency": {
    "code": "GHS",
    "minor_unit_scale": 2,
    "note": "Ghanaian messages write the amount as GHS 50.00, GH\u00a250.00, GH\u20b5 50.00 or bare 50.00. Cedi symbol U+20B5, pesewa U+00A2."
  },
  "tokens": {
    "N": "([0-9][0-9,]*(?:[.][0-9]{1,2})?)",
    "CUR": "(?:GHS|GH[\u00a2\u20b5\u00a2]|\u20b5|GHC|GH|cedis?|sewapes)?\\s*",
    "NAME": "(?-i:([A-Z][A-Z '\\-&]{1,40}?))",
    "NAME_LAX": "(?-i:([A-Za-z][A-Za-z '\\-&]{1,40}?))",
    "PHONE": "(?<![0-9])(?:\\+?233[\\s-]?)?0?([2-5][0-9][\\s-]?[0-9]{3}[\\s-]?[0-9]{4})(?![0-9])",
    "ID": "([A-Z0-9]{6,20})",
    "ID16": "([0-9]{16})",
    "DATE": "([0-9]{4}-[0-9]{2}-[0-9]{2}|[0-9]{1,2}[/.-][0-9]{1,2}[/.-][0-9]{2,4})",
    "TIME": "([0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?(?:\\s*[APap]\\.?[Mm]\\.?)?)",
    "REF": "([^.\\n]{2,40}?)",
    "NDELIM": "(?:\\s*[.](?:\\s|$)|\\s+on\\b|\\s+at\\b|\\s*[(\\[]|\\s+-\\s|\\s*[,;]|\\s*$)",
    "NDELIM_HARD": "(?:\\s*[.](?:\\s|$)|\\s+on\\b|\\s+at\\b|\\s*[(\\[]|\\s+-\\s|\\s*[,;]|\\s+(?=(?-i:[a-z]))|\\s*$)"
  },
  "fields": [
    "amount",
    "fee",
    "levy",
    "balance",
    "trx_id",
    "reference",
    "counterparty_name",
    "counterparty_phone",
    "paybill_name",
    "paybill_account",
    "date",
    "time",
    "status",
    "channel",
    "tx_kind",
    "direction"
  ],
  "kind_to_transaction_type": {
    "p2p_transfer_out": "EXPENSE",
    "p2p_transfer_in": "INCOME",
    "deposit": "INCOME",
    "withdrawal": "EXPENSE",
    "merchant_payment": "EXPENSE",
    "paybill_payment": "EXPENSE",
    "airtime_purchase": "EXPENSE",
    "data_bundle": "EXPENSE",
    "loan_disbursement": "INCOME",
    "loan_repayment": "EXPENSE",
    "reversal": "INCOME",
    "balance_transfer_out": "TRANSFER",
    "unknown_out": "EXPENSE",
    "unknown_in": "INCOME"
  },
  "skip_rules": [
    {
      "id": "otp",
      "pattern": "\\b(otp|one time password|pin is|verification code|password)\\b",
      "reason": "credential message, not a transaction"
    },
    {
      "id": "promo",
      "pattern": "\\b(congratulations|you have won|bonus offer|register now|promo|lottery)\\b",
      "reason": "promotional message"
    },
    {
      "id": "request_to_pay",
      "pattern": "(has requested|requests you to pay|pay .* on behalf|approve the payment by)",
      "reason": "payment request / approval prompt; no money moved yet"
    },
    {
      "id": "loan_marketing",
      "pattern": "(apply now|you are eligible for a loan|loan offer of)",
      "reason": "credit marketing, no disbursement"
    },
    {
      "id": "third_party_topup",
      "pattern": "\\b(airtime|recharge|top[- ]?up)\\b.{0,40}?\\bis ready for (?:your|the)\\b",
      "reason": "third-party top-up notice: no wallet debit is described",
      "note": "Third-party top-up credit notice: the money came from someone else and no wallet debit is described. The quantifier must allow a decimal point, and the distinctive 'is ready for your number' phrasing keeps genuine purchases ('You have purchased GHS X worth of airtime') out of it."
    }
  ],
  "status_rules": [
    {
      "id": "status.reversal",
      "pattern": "\\b(reversed|reversal|refunded|credited back)\\b",
      "status": "SUCCESS",
      "note": "must precede status.failed: '...reversed for the failed transaction' describes a past failure, not this credit"
    },
    {
      "id": "status.failed",
      "pattern": "\\b(failed|not successful|unsuccessful|declined|cancelled|canceled|reversed|could not be processed)\\b",
      "status": "FAILED"
    },
    {
      "id": "status.pending",
      "pattern": "\\b(pending|processing|awaiting|in progress|to be confirmed|authori[sz]e)\\b",
      "status": "PENDING"
    },
    {
      "id": "status.success",
      "pattern": "\\b(successful(?:ly)?|confirmed|credited|debited|paid|received|sent|purchased|bought|recharged|topped up|applied|deducted)\\b",
      "status": "SUCCESS"
    }
  ],
  "direction_rules": [
    {
      "id": "dir.in",
      "pattern": "(you have received|payment received|received (?:from|a deposit)|credited (?:you|your|to your)|deposit (?:of|received)|you have deposited|money in|you received)",
      "direction": "IN"
    },
    {
      "id": "dir.out",
      "pattern": "(you have sent|payment made|payment of|sent to|sent money|debited|debit of|withdraw|you (?:have )?(?:paid|purchased|bought|deposited)|made a payment|cash out|you have successfully purchased)",
      "direction": "OUT"
    }
  ],
  "shared_fields": {
    "amount": [
      {
        "id": "amt.currency_first",
        "regex": "(?:GHS|GH[\u00a2\u20b5]|\u20b5)\\s*{N}",
        "group": 1,
        "note": "first money token in the message; fee/balance mentions are later in the string, so first-match wins for the transaction amount"
      },
      {
        "id": "amt.after_verb",
        "regex": "\\b(?:sent|paid|received|withdrawn|deposited|transferred|credited|debited|reversed)\\s+(?:GHS|GH[\u00a2\u20b5]|\u20b5)?\\s*{N}",
        "group": 1
      },
      {
        "id": "amt.before_verb",
        "regex": "{N}\\s+(?:was|has been)?\\s*(?:sent|paid|received|withdrawn|deposited|credited|debited)",
        "group": 1
      }
    ],
    "balance": [
      {
        "id": "bal.current_labelled",
        "regex": "\\b(?:current|new|updated|available|remaining|final)\\s+(?:momo|wallet|cash)?\\s*balance\\b[^0-9]{0,12}{N}",
        "group": 1
      },
      {
        "id": "bal.possessive",
        "regex": "\\b(?:your )?(?:momo|telecel cash|aireltigo money|wallet) balance (?:is|was|of)\\b[^0-9]{0,12}{N}",
        "group": 1
      },
      {
        "id": "bal.bare",
        "regex": "\\bbalance\\s*[:=]?\\s*(?:GHS|GH[\u00a2\u20b5]|\u20b5)?\\s*{N}",
        "group": 1
      }
    ],
    "fee": [
      {
        "id": "fee.labeled",
        "regex": "\\b(?:fee(?:\\s+charged)?|service charge|commission|handling fee)\\s*[:=]?\\s*(?:GHS|GH[\u00a2\u20b5]|\u20b5)?\\s*{N}",
        "group": 1,
        "note": "must never be mistaken for the transaction amount - Ghana MoMo SMS put Fee after the amount and before the balance"
      }
    ],
    "levy": [
      {
        "id": "levy.elevy",
        "regex": "\\b(?:e[- ]?levy|electronic transfer levy|levy(?:\\s+charged)?)\\s*[:=]?\\s*(?:GHS|GH[\u00a2\u20b5]|\u20b5)?\\s*{N}",
        "group": 1,
        "note": "Electronic Transaction Levy (1.5% above the GHS 100 daily cumulative threshold, capped at GHS 150) - appears on some operator alerts"
      }
    ],
    "trx_id": [
      {
        "id": "trx.labeled",
        "regex": "\\b(?:transaction\\s*(?:id|ref(?:erence)?)|txn\\s*id|trx\\s*id|trans\\s*id|tid|txn)\\b\\s*[:#]?\\s*{ID}",
        "group": 1
      },
      {
        "id": "trx.paren",
        "regex": "\\b(?:transaction\\s*(?:id|ref(?:erence)?)|txn\\s*id|trx\\s*id|ref)\\b\\s*[:#]?\\s*[(\\[]?([A-Z0-9]{6,20})[)\\]]?",
        "group": 1
      }
    ],
    "reference": [
      {
        "id": "ref.labeled",
        "regex": "\\b(?:reference|narration|remark|note|description)\\s*[:=]\\s*{REF}[.]?(?:\\s|$)",
        "group": 1
      }
    ],
    "counterparty_name": [
      {
        "id": "cp.to_upper",
        "regex": "\\b(?:sent to|paid to|made payment to|to)\\s+{NAME}(?={NDELIM})",
        "note": "upper-case counterparties (MTN/AirtelTigo print names in caps); the lookahead keeps the lazy quantifier from running into the footer"
      },
      {
        "id": "cp.from_upper",
        "regex": "\\b(?:received from|received a deposit from|from)\\s+{NAME}(?={NDELIM})"
      },
      {
        "id": "cp.dash_name",
        "regex": "\\b(?:to|from)\\s+{PHONE}\\s*-\\s*{NAME_LAX}(?={NDELIM})",
        "group": 2
      },
      {
        "id": "cp.to_title",
        "regex": "\\b(?:sent to|paid to|to|from)\\s+(?-i:([A-Z][A-Za-z'&\\-]{1,20}(?: [A-Z][A-Za-z'&\\-]{1,20}){0,3}))(?={NDELIM})",
        "note": "Title-case fallback for operators that do not shout; the leading upper-case requirement is what keeps 'Dial *170# to manage your wallet' from being read as a person"
      }
    ],
    "counterparty_phone": [
      {
        "id": "ph.parens",
        "regex": "[(\\[]\\s*{PHONE}\\s*[)\\]]",
        "group": 1
      },
      {
        "id": "ph.generic",
        "regex": "\\b(?:to|from|for|number)\\s+{PHONE}\\b",
        "group": 1
      },
      {
        "id": "ph.loose",
        "regex": "\\b{PHONE}\\b",
        "group": 1
      }
    ],
    "paybill_name": [
      {
        "id": "pb.name_before_id",
        "regex": "\\b(?:to|for)\\s+{NAME}(?=\\s*(?:paybill|business|merchant|till|shop|store))",
        "group": 1
      },
      {
        "id": "pb.to_delimited",
        "regex": "\\b(?:to|for)\\s+{NAME}(?=\\s*[(\\[](?=[^)]{0,40}(?:paybill|business|merchant|till|\\bid\\b|\\bno\\b)))",
        "group": 1
      },
      {
        "id": "pb.to_title",
        "regex": "\\b(?:to|for)\\s+(?-i:([A-Z][A-Za-z'&\\-]{1,20}(?: [A-Z][A-Za-z'&\\-]{1,20}){1,3}))(?=\\s*(?:[(\\[](?=[^)]{0,40}(?:paybill|business|merchant|till|\\bid\\b|\\bno\\b))|paybill|business|merchant|till))",
        "group": 1,
        "note": "Title-case merchant names (some AirtelTigo/Telecel alerts do not shout)"
      }
    ],
    "paybill_account": [
      {
        "id": "pb.account",
        "regex": "\\b(?:paybill|business|merchant|till|bill|meter|account)\\s*(?:no|number|id|code|ref)?\\s*[:#]?\\s*([0-9][0-9 /-]{2,19})",
        "group": 1
      }
    ],
    "date": [
      {
        "id": "dt.iso",
        "regex": "\\bon\\s+([0-9]{4}-[0-9]{2}-[0-9]{2})",
        "group": 1
      },
      {
        "id": "dt.any",
        "regex": "([0-9]{4}-[0-9]{2}-[0-9]{2}|[0-9]{1,2}[/.-][0-9]{1,2}[/.-][0-9]{2,4})",
        "group": 1
      }
    ],
    "time": [
      {
        "id": "tm.at",
        "regex": "\\bat\\s+{TIME}",
        "group": 1
      },
      {
        "id": "tm.any",
        "regex": "\\b{TIME}",
        "group": 1
      }
    ],
    "channel": [
      {
        "id": "ch.agent",
        "regex": "\\b(?:via|through|at|from)\\s+((?:momo |telecel |at )?agent(?:\\s+[A-Z][A-Z .\\-]{0,25})?)",
        "group": 1,
        "value": "agent"
      },
      {
        "id": "ch.app",
        "regex": "\\b(?:via|through|using|on)\\s+(?:the )?(momo app|mobile app|telecel cash app|super app|at money app|my telecel app|momo\\s*app)",
        "group": 1,
        "value": "app"
      },
      {
        "id": "ch.ussd",
        "regex": "\\b(?:via|through|using|dialled|dial)\\s+(\\*[0-9]{2,3}#(?:\\*[0-9]{1,3}#)*)",
        "group": 1,
        "value": "ussd",
        "note": "requires a preposition: bare 'Dial *170# to manage your wallet' is a marketing footer, not this transaction's channel"
      },
      {
        "id": "ch.atm",
        "regex": "\\b(?:via|at|from)\\s+(atm|cash self[- ]service|self[- ]service machine)",
        "group": 1,
        "value": "atm"
      },
      {
        "id": "ch.pos",
        "regex": "\\b(?:via|using|at)\\s+(pos(?:\\s+(?:terminal|payment))?|momo\\s*pay|merchant terminal)",
        "group": 1,
        "value": "pos"
      }
    ]
  },
  "operators": [
    {
      "id": "mtn_momo",
      "display_name": "MTN Mobile Money (MoMo)",
      "sender_patterns": [
        "^MTN([ -]?(MOMO|MOBI|MOMO\\s*PSB|PSB\\s*LTD))?$",
        "^MOMO(PSB)?$",
        "^MTN\\s*MO\\s*MO$",
        "^MO\\s*MONEY$"
      ],
      "sender_note": "TODO(verify): MTN alert short codes seen in the wild include 'MTN', 'MTN-MOMO' and 'MoMo PSB Ltd'. The real sender inventory MUST be derived from the author's corpus with tools/taxonomy.py before this list is treated as final - sender IDs are spoofable, so this is a routing hint, never an authenticity check.",
      "body_markers": [
        "\\bmtn\\b",
        "\\bmomo\\b",
        "\\bmomo psb\\b",
        "current balance:",
        "payment made for",
        "payment received for"
      ],
      "templates": [
        {
          "id": "mtn.p2p_out.make_payment",
          "kind": "p2p_transfer_out",
          "priority": 10,
          "regex": "^Payment made for\\s+{CUR}{N}\\s+to\\s+{NAME}\\.\\s*(?:.*?Current Balance:\\s*{CUR}{N})?\\s*(?:.*?Reference:\\s*{REF}\\.)?\\s*(?:.*?Transaction ID:\\s*{ID})?\\s*(?:.*?Fee charged:\\s*{CUR}{N})?",
          "groups": [
            {
              "field": "amount",
              "idx": 1
            },
            {
              "field": "counterparty_name",
              "idx": 2
            },
            {
              "field": "balance",
              "idx": 3
            },
            {
              "field": "reference",
              "idx": 4
            },
            {
              "field": "trx_id",
              "idx": 5
            },
            {
              "field": "fee",
              "idx": 6
            }
          ]
        },
        {
          "id": "mtn.p2p_in.make_payment",
          "kind": "p2p_transfer_in",
          "priority": 10,
          "regex": "^Payment received for\\s+{CUR}{N}\\s+from\\s+{NAME}{NDELIM_HARD}(?:\\s*[-(]\\s*{PHONE})?\\.\\s*(?:.*?Current Balance:\\s*{CUR}{N})?\\s*(?:.*?Reference:\\s*{REF}\\.)?\\s*(?:.*?Transaction ID:\\s*{ID})?",
          "groups": [
            {
              "field": "amount",
              "idx": 1
            },
            {
              "field": "counterparty_name",
              "idx": 2
            },
            {
              "field": "counterparty_phone",
              "idx": 3
            },
            {
              "field": "balance",
              "idx": 4
            },
            {
              "field": "reference",
              "idx": 5
            },
            {
              "field": "trx_id",
              "idx": 6
            }
          ]
        },
        {
          "id": "mtn.p2p_out.classic",
          "kind": "p2p_transfer_out",
          "priority": 20,
          "regex": "^You have sent\\s+{CUR}{N}\\s+to\\s+{NAME}{NDELIM_HARD}(?:\\s*[-(]\\s*{PHONE})?\\s+on\\s+{DATE}(?:\\s+at\\s+{TIME})?\\.?\\s*(?:.*?balance (?:is|of|after transaction)\\s*{CUR}{N})?\\s*(?:.*?Transaction ID:\\s*{ID})?",
          "groups": [
            {
              "field": "amount",
              "idx": 1
            },
            {
              "field": "counterparty_name",
              "idx": 2
            },
            {
              "field": "counterparty_phone",
              "idx": 3
            },
            {
              "field": "date",
              "idx": 4
            },
            {
              "field": "time",
              "idx": 5
            },
            {
              "field": "balance",
              "idx": 6
            },
            {
              "field": "trx_id",
              "idx": 7
            }
          ]
        },
        {
          "id": "mtn.p2p_in.classic",
          "kind": "p2p_transfer_in",
          "priority": 20,
          "regex": "^You have received\\s+{CUR}{N}\\s+from\\s+{NAME}{NDELIM_HARD}(?:\\s*[-(]\\s*{PHONE})?\\s+on\\s+{DATE}(?:\\s+at\\s+{TIME})?\\.?\\s*(?:.*?balance (?:is|of|after transaction)\\s*{CUR}{N})?\\s*(?:.*?Transaction ID:\\s*{ID})?",
          "groups": [
            {
              "field": "amount",
              "idx": 1
            },
            {
              "field": "counterparty_name",
              "idx": 2
            },
            {
              "field": "counterparty_phone",
              "idx": 3
            },
            {
              "field": "date",
              "idx": 4
            },
            {
              "field": "time",
              "idx": 5
            },
            {
              "field": "balance",
              "idx": 6
            },
            {
              "field": "trx_id",
              "idx": 7
            }
          ]
        },
        {
          "id": "mtn.deposit.agent",
          "kind": "deposit",
          "priority": 20,
          "regex": "^(?:Deposit of\\s+{CUR}{N}(?:\\s+from\\s+{NAME}{NDELIM_HARD})?|You have deposited\\s+{CUR}{N}\\s+into your\\s+(?:momo\\s+)?(?:wallet|account))(?:\\s+\\w+\\s+\\S+)?(?:\\s+at\\s+{NAME}{NDELIM_HARD})?\\s*(?:.{0,40}?successful|\\.\\s*)?(?:.*?(?:new|current|your) balance (?:is|of|after transaction)?:?\\s*{CUR}{N})?\\s*(?:.*?Transaction ID:\\s*{ID})?\\s*(?:.*?Fee(?:\\s+charged)?:?\\s*{CUR}{N})?",
          "groups": [
            {
              "field": "amount",
              "idx": 1
            },
            {
              "field": "counterparty_name",
              "idx": 2
            },
            {
              "field": "balance",
              "idx": 3
            },
            {
              "field": "trx_id",
              "idx": 4
            },
            {
              "field": "fee",
              "idx": 5
            }
          ]
        },
        {
          "id": "mtn.withdrawal.agent",
          "kind": "withdrawal",
          "priority": 20,
          "regex": "^You have (?:withdrawn|made a cash out of)\\s+{CUR}{N}.*?(?:.*?(?:new|current) balance (?:is|of)?:?\\s*{CUR}{N})?\\s*(?:.*?Transaction ID:\\s*{ID})?\\s*(?:.*?Fee(?:\\s+charged)?:?\\s*{CUR}{N})?",
          "groups": [
            {
              "field": "amount",
              "idx": 1
            },
            {
              "field": "balance",
              "idx": 2
            },
            {
              "field": "trx_id",
              "idx": 3
            },
            {
              "field": "fee",
              "idx": 4
            }
          ]
        },
        {
          "id": "mtn.paybill.payment",
          "kind": "paybill_payment",
          "priority": 15,
          "regex": "^Payment of\\s+{CUR}{N}\\s+to\\s+{NAME}\\s*[(\\[]?\\s*(?:(?:paybill|business|merchant|till|account)\\s*(?:no|id|number|code)?\\s*[:#]?\\s*([A-Z0-9 -]{3,20}))\\s*[)\\]]?[^.]*\\.?\\s*(?:.*?balance\\s*(?:is|of|after transaction)?\\s*[:=]?\\s*{CUR}{N})?\\s*(?:.*?Transaction ID:\\s*{ID})?",
          "groups": [
            {
              "field": "amount",
              "idx": 1
            },
            {
              "field": "paybill_name",
              "idx": 2
            },
            {
              "field": "paybill_account",
              "idx": 3
            },
            {
              "field": "balance",
              "idx": 4
            },
            {
              "field": "trx_id",
              "idx": 5
            }
          ]
        },
        {
          "id": "mtn.momo_pay.merchant",
          "kind": "merchant_payment",
          "priority": 15,
          "regex": "^You have paid\\s+{CUR}{N}\\s+to\\s+{NAME}{NDELIM_HARD}.*?(?:.*?balance\\s*(?:is|of|after transaction)?:?\\s*{CUR}{N})?\\s*(?:.*?(?:Transaction|Merchant|Terminal)\\s*ID:\\s*{ID})?",
          "groups": [
            {
              "field": "amount",
              "idx": 1
            },
            {
              "field": "paybill_name",
              "idx": 2
            },
            {
              "field": "balance",
              "idx": 3
            },
            {
              "field": "trx_id",
              "idx": 4
            }
          ]
        },
        {
          "id": "mtn.airtime.purchase",
          "kind": "airtime_purchase",
          "priority": 12,
          "regex": "^You have (?:bought|purchased|recharged)\\s+{CUR}{N}\\s+(?:worth of )?(?:airtime|credit|recharge)(?:\\s+for\\s+{PHONE})?.*?(?:.*?balance\\s*[:=]?\\s*{CUR}{N})?",
          "groups": [
            {
              "field": "amount",
              "idx": 1
            },
            {
              "field": "counterparty_phone",
              "idx": 2
            },
            {
              "field": "balance",
              "idx": 3
            }
          ]
        },
        {
          "id": "mtn.data_bundle.purchase",
          "kind": "data_bundle",
          "priority": 12,
          "regex": "^You have (?:successfully )?(?:bought|purchased|subscribed to)\\s+(?:a\\s+)?(?:[0-9.]+\\s*[KMGT]?B\\s+)?data (?:bundle|plan|package)(?:\\s+(?:of|for)\\s*{CUR}{N})?.*?(?:.*?(?:for|to)\\s+(?:\\+?233\\s?)?0?[2-5][0-9]{8})?(?:.*?balance\\s*(?:is|of)?\\s*[:=]?\\s*{CUR}{N})?",
          "groups": [
            {
              "field": "amount",
              "idx": 1
            },
            {
              "field": "counterparty_phone",
              "idx": 2
            },
            {
              "field": "balance",
              "idx": 3
            }
          ]
        },
        {
          "id": "mtn.loan.disbursement",
          "kind": "loan_disbursement",
          "priority": 18,
          "regex": "^A (?:loan|advance) (?:of|amounting to)\\s+{CUR}{N}\\s+has been (?:credited|disbursed).*?(?:.*?balance\\s*[:=]?\\s*{CUR}{N})?\\s*(?:.*?(?:Loan|Transaction)\\s*ID:\\s*{ID})?",
          "groups": [
            {
              "field": "amount",
              "idx": 1
            },
            {
              "field": "balance",
              "idx": 2
            },
            {
